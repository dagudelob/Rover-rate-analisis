# Rover Market Intelligence Configuration
# Copy this file to .env and fill in your secrets

# Database Configuration
# Local SQLite path (default fallback)
DB_PATH=rover_market.db

# Supabase Integration (Leave empty to use local SQLite)
SUPABASE_URL=https://bjxlcnmiccgecjhpumqv.supabase.co
SUPABASE_KEY=your_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional

# Server & CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Scraper Settings
SCRAPER_MAX_PAGES=15
SCRAPER_MAX_RESULTS=200
